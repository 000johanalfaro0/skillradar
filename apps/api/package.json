{
  "name": "@skillradar/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create skillradar",
    "db:migrate:local": "wrangler d1 migrations apply skillradar --local",
    "db:migrate:remote": "wrangler d1 migrations apply skillradar --remote",
    "db:seed:local": "wrangler d1 execute skillradar --local --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.12.34"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.97.0"
  }
}
